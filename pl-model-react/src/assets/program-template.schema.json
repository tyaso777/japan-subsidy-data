{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/pl-model/program-template.schema.json",
  "title": "PL Model Program Template",
  "type": "object",
  "required": ["schemaVersion", "program", "definitions", "timeline"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string" },
    "program": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "definitions": {
      "type": "object",
      "required": ["historical", "periods", "specialYears", "commonNumericDefinitions", "managementMetrics"],
      "additionalProperties": false,
      "properties": {
        "historical": {
          "type": "object",
          "required": ["id", "label", "fixed"],
          "additionalProperties": false,
          "properties": { "id": { "const": "historical" }, "label": { "type": "string" }, "fixed": { "const": true } }
        },
        "periods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/periodDefinition" } },
        "specialYears": { "type": "array", "items": { "$ref": "#/$defs/specialYear" } },
        "commonNumericDefinitions": { "type": "array", "items": { "$ref": "#/$defs/numericDefinition" } },
        "managementMetrics": { "type": "array", "items": { "$ref": "#/$defs/managementMetric" } }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["historical", "periods"],
      "additionalProperties": false,
      "properties": {
        "historical": { "$ref": "#/$defs/yearRange" },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["definitionId", "startYear", "endYear"],
            "additionalProperties": false,
            "properties": {
              "definitionId": { "type": "string" },
              "startYear": { "type": "integer" },
              "endYear": { "type": "integer" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "yearRange": {
      "type": "object",
      "required": ["startYear", "endYear"],
      "additionalProperties": false,
      "properties": { "startYear": { "type": "integer" }, "endYear": { "type": "integer" } }
    },
    "periodDefinition": {
      "type": "object",
      "required": ["id", "label", "modelPhase"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "modelPhase": { "enum": ["toBase", "postBase"] }
      }
    },
    "anchor": {
      "oneOf": [
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "historicalEnd" } } },
        { "type": "object", "required": ["type", "periodId"], "additionalProperties": false, "properties": { "type": { "enum": ["periodStart", "periodEnd"] }, "periodId": { "type": "string" } } }
      ]
    },
    "metricAnchor": {
      "oneOf": [
        { "type": "object", "required": ["type"], "additionalProperties": false, "properties": { "type": { "const": "historicalEnd" } } },
        { "type": "object", "required": ["type", "specialYearId"], "additionalProperties": false, "properties": { "type": { "const": "specialYear" }, "specialYearId": { "type": "string" } } },
        { "type": "object", "required": ["type", "periodId"], "additionalProperties": false, "properties": { "type": { "enum": ["periodStart", "periodEnd"] }, "periodId": { "type": "string" } } }
      ]
    },
    "specialYear": {
      "type": "object",
      "required": ["id", "label", "anchor", "offset"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "anchor": { "$ref": "#/$defs/anchor" }, "offset": { "type": "integer" } }
    },
    "plDisplay": {
      "type": "object",
      "required": ["enabled", "insertAfter", "insertOrder", "valueKind"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "insertAfter": { "type": "string" },
        "insertOrder": { "type": "integer", "minimum": 1 },
        "valueKind": { "enum": ["money", "percent", "point", "fte", "count", "moneyPerPerson", "multiple", "index"] },
        "indent": { "enum": [0, 1, 2] }
      }
    },
    "numericDefinition": {
      "type": "object",
      "required": ["id", "label", "formula", "outputPoint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "label": { "type": "string" }, "formula": { "type": "string" }, "outputPoint": { "type": "string" }, "plDisplay": { "$ref": "#/$defs/plDisplay" }
      }
    },
    "timePoint": {
      "type": "object",
      "required": ["id", "anchor", "offset"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "anchor": { "$ref": "#/$defs/metricAnchor" }, "offset": { "type": "integer" } }
    },
    "managementMetric": {
      "type": "object",
      "required": ["id", "label", "enabled", "scope", "timePoints", "formula", "outputUnit", "target", "direction", "optimization"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "label": { "type": "string" }, "enabled": { "type": "boolean" },
        "scope": { "enum": ["company", "base", "subsidy"] },
        "timePoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/timePoint" } },
        "formula": { "type": "string" }, "outputUnit": { "type": "string" }, "target": { "type": "number" },
        "direction": { "enum": ["min", "max"] }, "targetPolicy": { "enum": ["reference", "minimum", "maximum"] },
        "optimization": { "enum": ["adjustable", "fixed"] }, "requiresActualInput": { "type": "boolean" }, "calculationUnavailable": { "type": "boolean" }
      }
    }
  }
}
